# Copia este archivo como .env para probar en tu computadora.
# En Vercel NO se sube este archivo: las mismas variables se cargan en
# Settings → Environment Variables del proyecto.
#
# ⚠️ Nunca subas el .env a GitHub ni pongas la clave en el HTML.

# 1) Clave de API de Resend → https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# 2) Remitente.
#    · Para empezar sin dominio propio: onboarding@resend.dev
#      (en ese modo Resend SOLO deja enviar al correo con el que te registraste)
#    · Con dominio verificado en Resend: citas@tudominio.com
MAIL_FROM=Clínica Almendra <onboarding@resend.dev>

# 3) Correo del dentista donde deben llegar las citas.
#    Mientras uses onboarding@resend.dev, tiene que ser el mismo correo
#    de la cuenta de Resend. Acepta varios separados por coma.
MAIL_TO=dentista@tudominio.com

# 4) Datos que aparecen al pie de los correos
CLINICA_NOMBRE=Clínica Dental Almendra
CLINICA_TEL=55 1234 5678
CLINICA_DIR=Av. Reforma 128, piso 3, consultorio 302, Col. Juárez, CDMX
